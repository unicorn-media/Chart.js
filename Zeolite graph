<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Superfine Zeolite Pricing Graph</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <h1>Superfine Zeolite Pricing Graph</h1>
    <canvas id="zeoliteChart" width="800" height="400"></canvas>
    <script>
        const ctx = document.getElementById('zeoliteChart').getContext('2d');
        const data = {
            labels: ['0.001 kg', '0.01 kg', '0.1 kg', '1 kg', '10 kg', '100 kg', '1000 kg'],
            datasets: [
                {
                    label: 'Powder Price (USD)',
                    data: [0.50, 4.50, 40.00, 400.00, 3500.00, 30000.00, 250000.00],
                    borderColor: 'rgba(75, 192, 192, 1)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    fill: false,
                    tension: 0.1
                },
                {
                    label: 'Capsule Price (USD)',
                    data: [1.00, 9.00, 80.00, 750.00, 6500.00, 55000.00, 450000.00],
                    borderColor: 'rgba(153, 102, 255, 1)',
                    backgroundColor: 'rgba(153, 102, 255, 0.2)',
                    fill: false,
                    tension: 0.1
                }
            ]
        };

        const config = {
            type: 'line',
            data: data,
            options: {
                scales: {
                    x: {
                        type: 'logarithmic',
                        title: {
                            display: true,
                            text: 'Weight (kg)'
                        }
                    },
                    y: {
                        title: {
                            display: true,
                            text: 'Price (USD)'
                        }
                    }
                },
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ': $' + context.raw;
                            }
                        }
                    }
                }
            }
        };

        const zeoliteChart = new Chart(ctx, config);
    </script>
</body>
</html>
